{
  "name": "ninesoft-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "NineSoft secure desktop web client for Windows",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.ninesoft.accounting",
    "productName": "NineSoft",
    "files": [
      "main.cjs",
      "preload.cjs",
      "setup.html",
      "package.json"
    ],
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NineSoft-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
