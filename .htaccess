Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
Header always set X-Content-Type-Options nosniff
Header always set Referrer-Policy strict-origin-when-cross-origin
Header always set X-Frame-Options DENY
</IfModule>
<FilesMatch "^(config(\.local|\.example)?\.php|bootstrap\.php|schema\.sql|composer\.(json|lock)|\.env|\.gitignore|README\.md)$">
Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^(src|docs|tests|clients|storage|\.github)/ - [F,L,NC]
